// Windows exe icon; GLFW also picks up GLFW_ICON as the default window icon
GLFW_ICON ICON "@OPCAN_ICO@"

#include <winver.h>
#ifdef __GNUC__
// windres (MinGW): embed the manifest here; MSVC embeds packaging/opcan.manifest as a source file
1 24 "@OPCAN_MANIFEST@"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "opcan contributors"
      VALUE "FileDescription", "opcan - open chess analysis"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "opcan"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "opcan.exe"
      VALUE "ProductName", "opcan"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
